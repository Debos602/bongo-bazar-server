generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int        @id @default(autoincrement())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  email      String     @unique
  name       String
  password   String
  phone      String
  picture    String?
  needPasswordChange Boolean @default(false)

  isVerified Boolean    @default(false)
  status     UserStatus @default(ACTIVE)
  role       Role       @default(USER)

  posts      Post[]
  reviews    Review[]
  carts      Cart[]
  orders     Order[]
  wishlist   Wishlist[]
  addresses  Address[]
  vendor     Vendor?    // যদি ইউজার ভেন্ডার হয়, Vendor info থাকবে

  notifications Notification[]
  
  @@index([role, createdAt])
  @@index([status])
  @@index([createdAt])
}

model Vendor {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id])
  shopName  String
  slug      String    @unique
  description String?
  logo      String?
  banner    String?
  phone     String?
  address   String?
  status    VendorStatus @default(PENDING)
  rejectionReason String?
  approvedAt DateTime?
  commissionRate Float?   // null = platform default (PLATFORM_COMMISSION_RATE)
  products  Product[]
  vendorOrders VendorOrder[]
  coupons   Coupon[]
  payouts   Payout[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([status, createdAt])
}

model Product {
  id            Int      @id @default(autoincrement())

  name          String
  slug          String   @unique
  description   String?

  price         Float
  oldPrice      Float?
  discount      Int?
  tags         String[]
  badgeType     BadgeType?   
  image         String
  images        String[]

  stock         Int      @default(0)
  sku           String?

  rating        Float    @default(0)
  reviewCount   Int      @default(0)

  categories    ProductCategory[]

  isFeatured    Boolean  @default(false)
  isPublished   Boolean  @default(true)
  isBlocked     Boolean  @default(false) // set by admin moderation; vendor cannot undo

  reviews       Review[]
  carts         Cart[]
  orderItems    OrderItem[]
  wishlist      Wishlist[]

  vendorId      Int
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished, isBlocked, createdAt])
  @@index([vendorId, createdAt])
  @@index([rating])
  @@index([price])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  Image  String?
  products  ProductCategory[]
}

model ProductCategory {
  productId  Int
  categoryId Int

  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])

  @@index([categoryId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?

  userId    Int
  productId Int

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int      @default(1)

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
    @@unique([userId, productId])

  @@index([productId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])

  @@index([productId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int

  fullName  String
  phone     String
  city      String
  area      String
  address   String
  postalCode String?

  user      User     @relation(fields: [userId], references: [id])
  orders    Order[]

  @@index([userId])
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  addressId   Int

  subtotal    Float       @default(0)
  discount    Float       @default(0)
  total       Float
  couponCode  String?
  status      OrderStatus @default(PENDING)

  payment     Payment?
  items       OrderItem[]
  vendorOrders VendorOrder[]

  user        User     @relation(fields: [userId], references: [id])
  address     Address  @relation(fields: [addressId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([addressId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())

  orderId   Int
  productId Int

  quantity  Int
  price     Float

  vendorOrderId Int?

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  vendorOrder VendorOrder? @relation(fields: [vendorOrderId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([vendorOrderId])
}

// One order is split into one VendorOrder per vendor; each vendor fulfils only its own part.
model VendorOrder {
  id        Int         @id @default(autoincrement())
  orderId   Int
  vendorId  Int
  status    OrderStatus @default(PENDING)

  subtotal         Float
  vendorDiscount   Float @default(0) // from a coupon the vendor issued; vendor pays
  platformDiscount Float @default(0) // from a platform coupon; platform pays
  total            Float             // what the customer pays for this part
  commissionRate   Float @default(0)
  commissionAmount Float @default(0)
  vendorEarning    Float @default(0)
  trackingNumber   String?

  order     Order       @relation(fields: [orderId], references: [id])
  vendor    Vendor      @relation(fields: [vendorId], references: [id])
  items     OrderItem[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@unique([orderId, vendorId])
  @@index([vendorId, status])

  @@index([vendorId, createdAt])
  @@index([status, createdAt])
}

model Payout {
  id        Int          @id @default(autoincrement())
  vendorId  Int
  amount    Float
  status    PayoutStatus @default(PENDING)
  method    String
  accountDetails String
  note      String?
  transactionRef String?
  processedAt DateTime?

  vendor    Vendor       @relation(fields: [vendorId], references: [id])

  createdAt DateTime     @default(now())

  @@index([vendorId, status])

  @@index([status, createdAt])
}

model Payment {
  id          Int            @id @default(autoincrement())
  orderId     Int            @unique
  amount      Float
  method      PaymentMethod
  status      PaymentStatus  @default(PENDING)
  transactionId String?
  stripeSessionId String?
  refundedAmount Float       @default(0)

  order       Order          @relation(fields: [orderId], references: [id])

  createdAt   DateTime       @default(now())

  @@index([stripeSessionId])
}

model Coupon {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  discount    Int
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  usageLimit  Int?
  usedCount   Int      @default(0)

  vendorId    Int?     // null = platform coupon; set = applies only to that vendor's items
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])

  createdAt   DateTime @default(now())

  @@index([vendorId])
}

model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  thumbnail  String?
  isFeatured Boolean  @default(false)
  tags       String[]
  views      Int      @default(0)

  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
  USER
} 

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  STRIPE
  SSL_COMMERZ
  BKASH
  NAGAD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BadgeType {
  NEW
  HOT
  SALE
  BESTSELLER
  LIMITED
}